{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://alphaforge.dev/schemas/trust_tolerances.schema.json",
  "title": "Trust Gate Tolerance Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "version",
    "updated_at",
    "description",
    "metadata",
    "metrics"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^trust_gate_tolerances\\.v\\d+"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "required": [
        "maintained_by",
        "fr_references",
        "notes",
        "gate_defaults"
      ],
      "additionalProperties": false,
      "properties": {
        "maintained_by": {
          "type": "string",
          "minLength": 1
        },
        "fr_references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^FR-\\d+"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gate_defaults": {
          "type": "object",
          "minProperties": 1,
          "properties": {
            "equity_reconciliation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "absolute_currency_tolerance",
                "relative_basis_points_tolerance",
                "compare_adjusted_vs_unadjusted",
                "require_corporate_action_metadata"
              ],
              "properties": {
                "absolute_currency_tolerance": {
                  "type": "number",
                  "minimum": 0
                },
                "relative_basis_points_tolerance": {
                  "type": "number",
                  "minimum": 0
                },
                "compare_adjusted_vs_unadjusted": {
                  "type": "boolean"
                },
                "require_corporate_action_metadata": {
                  "type": "boolean"
                }
              }
            },
            "accounting_balance": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "absolute_currency_tolerance",
                "relative_basis_points_tolerance",
                "enforce_decimal_precision",
                "ledger_precision",
                "rounding_mode"
              ],
              "properties": {
                "absolute_currency_tolerance": {
                  "type": "number",
                  "minimum": 0
                },
                "relative_basis_points_tolerance": {
                  "type": "number",
                  "minimum": 0
                },
                "enforce_decimal_precision": {
                  "type": "boolean"
                },
                "ledger_precision": {
                  "type": "integer",
                  "minimum": 0
                },
                "rounding_mode": {
                  "type": "string",
                  "enum": [
                    "bankers",
                    "half_up",
                    "half_down"
                  ]
                }
              }
            },
            "ingest_idempotency": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "max_retry_attempts",
                "enforce_schema_version_match",
                "require_row_count_match",
                "permitted_hash_delta"
              ],
              "properties": {
                "max_retry_attempts": {
                  "type": "integer",
                  "minimum": 0
                },
                "enforce_schema_version_match": {
                  "type": "boolean"
                },
                "require_row_count_match": {
                  "type": "boolean"
                },
                "permitted_hash_delta": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "timezone_normalization": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "require_utc_storage",
                "max_offset_seconds",
                "ambiguous_transition_buffer_minutes",
                "allow_leap_second_events",
                "max_dst_gap_seconds"
              ],
              "properties": {
                "require_utc_storage": {
                  "type": "boolean"
                },
                "max_offset_seconds": {
                  "type": "integer"
                },
                "ambiguous_transition_buffer_minutes": {
                  "type": "integer",
                  "minimum": 0
                },
                "allow_leap_second_events": {
                  "type": "boolean"
                },
                "max_dst_gap_seconds": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "universe_stamp": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fail_on_missing_symbols",
                "warn_on_additional_symbols",
                "max_symbol_delta"
              ],
              "properties": {
                "fail_on_missing_symbols": {
                  "type": "boolean"
                },
                "warn_on_additional_symbols": {
                  "type": "boolean"
                },
                "max_symbol_delta": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "causality_guardrails": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "max_leakage_score",
                "max_equity_drift",
                "sharpe_floor"
              ],
              "properties": {
                "max_leakage_score": {
                  "type": "number",
                  "minimum": 0
                },
                "max_equity_drift": {
                  "type": "number"
                },
                "sharpe_floor": {
                  "type": "number"
                }
              }
            },
            "golden_run_determinism": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "require_manifest_match",
                "require_artifact_hash_match",
                "require_sqlite_digest_match",
                "allow_baseline_version_mismatch"
              ],
              "properties": {
                "require_manifest_match": {
                  "type": "boolean"
                },
                "require_artifact_hash_match": {
                  "type": "boolean"
                },
                "require_sqlite_digest_match": {
                  "type": "boolean"
                },
                "allow_baseline_version_mismatch": {
                  "type": "boolean"
                }
              }
            }
          },
          "additionalProperties": true
        }
      }
    },
    "metrics": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[A-Za-z0-9_.-]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "comparator",
            "threshold",
            "severity",
            "description"
          ],
          "properties": {
            "comparator": {
              "type": "string",
              "enum": ["<=", ">=", "<", ">"]
            },
            "threshold": {
              "type": "number"
            },
            "severity": {
              "type": "string",
              "enum": ["info", "warn", "fail"]
            },
            "description": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}
